# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build arguments
ARG VERSION=0.1.0

# Build the application with version
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-X main.version=$VERSION" -a -installsuffix cgo -o not-env-backend .

# Runtime stage
FROM alpine:latest

# Install SQLite
RUN apk --no-cache add ca-certificates sqlite

WORKDIR /app

# Create data directory for SQLite database
RUN mkdir -p /data && chmod 755 /data

# Copy the binary from builder
COPY --from=builder /app/not-env-backend .

# Set default environment variables for SQLite
ENV DB_TYPE=sqlite
ENV DB_PATH=/data/not-env.db

EXPOSE 1212

CMD ["./not-env-backend"]

